# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of the Next.js frontend (CORS + links in emails)
FRONTEND_URL=http://localhost:3000
# Number of reverse proxies in front of the API (Render/Railway/Next rewrites = 1)
TRUST_PROXY=1

# ── Supabase PostgreSQL ─────────────────────────────────
# Supabase dashboard → Project Settings → Database → Connection string
# Pooled (Transaction pooler, port 6543) — used by the running API
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
# Direct / Session pooler (port 5432) — used by Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Auth ────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=nt_token
PASSWORD_RESET_TTL_MINUTES=30

# ── Seed admin (npm run db:seed) ────────────────────────
SEED_ADMIN_EMAIL=admin@neurotask.app
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME=NeuroTask Admin

# ── Email (optional). If SMTP_HOST is empty, emails are logged to the console ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="NeuroTask <no-reply@neurotask.app>"

# ── Background jobs ─────────────────────────────────────
REMINDER_INTERVAL_SECONDS=300
